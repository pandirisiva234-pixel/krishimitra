# Copy this file to .env and fill in the values.  NEVER commit .env to Git.
#   copy .env.example .env      (Windows)

# ---------- Required ----------
# PostgreSQL connection (user, password, host, port, database)
DATABASE_URL=postgresql+psycopg://krishimitra:CHANGE_ME_DB_PASSWORD@localhost:5432/krishimitra

# Random secret, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_STRING_48_CHARS

# ---------- External APIs ----------
# Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# minimal | low | medium | high: answers are grounded in retrieved passages, so minimal is enough
GEMINI_THINKING_LEVEL=minimal
# OpenWeather key from https://home.openweathermap.org/api_keys (free plan; can take ~2 hours to activate)
OPENWEATHER_API_KEY=

# ---------- App ----------
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ACCESS_TOKEN_EXPIRE_MINUTES=60
RATE_LIMIT_ENABLED=true

# ---------- AI models ----------
# small = good balance on CPU; use medium with an NVIDIA GPU (WHISPER_DEVICE=cuda, WHISPER_COMPUTE_TYPE=float16)
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# 1 = fast greedy decoding (recommended on CPU); 5 = beam search, slower
WHISPER_BEAM_SIZE=1
NLLB_MODEL=facebook/nllb-200-distilled-600M
# transformers (simple) or ctranslate2 (int8, ~4x less RAM; set NLLB_CT2_PATH after converting)
NLLB_BACKEND=auto
# leave empty for the default trained_models/nllb-200-distilled-600M-ct2 (python -m scripts.get_fast_translator)
NLLB_CT2_PATH=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANK_ENABLED=true
RAG_TOP_K=20
RAG_TOP_N=5
DISEASE_CONFIDENCE_THRESHOLD=0.60
# true = load all models at startup (slower start, fast first request)
PRELOAD_MODELS=false

# ---- AI4Bharat IndicTrans2 (optional) ----
# nllb (default) or indictrans2. IndicTrans2 is gated: log in on huggingface.co, click "Agree" on
# ai4bharat/indictrans2-en-indic-dist-200M and ai4bharat/indictrans2-indic-en-dist-200M, create a Read token.
TRANSLATION_ENGINE=nllb
HF_TOKEN=
